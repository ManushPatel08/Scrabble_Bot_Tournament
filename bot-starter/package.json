{
  "name": "scrabblebot-bot-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "npm install --prefix ../spacetimedb && spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb && node scripts/sync-live-bindings.mjs",
    "sync-bindings": "node scripts/sync-live-bindings.mjs",
    "check-schema": "node scripts/check-live-schema.mjs",
    "start": "tsx src/index.ts",
    "get-token": "tsx scripts/get-token.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test \"test/*.test.ts\"",
    "sim": "node sim/run.ts",
    "compare": "node sim/compare.ts",
    "tune": "node sim/tune.ts",
    "trace": "node sim/trace.ts"
  },
  "dependencies": {
    "spacetimedb": "^2.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
